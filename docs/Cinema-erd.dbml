Table Genres {
  genre_id int [pk, not null]
  genre_name varchar(50) [not null, unique]
  genre_code varchar(10) [not null, unique]
  description varchar(255)
  is_active boolean [not null]
  created_at datetime [not null]
}

Table Movies {
  movie_id int [pk, not null]
  genre_id int [not null]
  title varchar(150) [not null]
  duration_minutes int [not null]
  release_date date [not null]
  language varchar(50) [not null]
  age_rating varchar(10) [not null]
  description varchar(255)
}

Table Theaters {
  theater_id int [pk, not null]
  theater_name varchar(100) [not null]
  city varchar(50) [not null]
  address varchar(255) [not null]
  phone_number varchar(20)
  email varchar(100)
  opening_time time [not null]
  closing_time time [not null]
}

Table Screens {
  screen_id int [pk, not null]
  theater_id int [not null]
  screen_number varchar(20) [not null]
  screen_type varchar(30) [not null]
  sound_system varchar(50)
  floor_number int
  wheelchair_accessible boolean [not null]
  is_active boolean [not null]

  indexes {
    (theater_id, screen_number) [unique]
  }
}

Table Seats {
  seat_id int [pk, not null]
  screen_id int [not null]
  row_label varchar(5) [not null]
  seat_number int [not null]
  seat_type varchar(30) [not null]
  is_accessible boolean [not null]
  is_active boolean [not null]
  created_at datetime [not null]

  indexes {
    (screen_id, row_label, seat_number) [unique]
  }
}

Table Showtimes {
  showtime_id int [pk, not null]
  movie_id int [not null]
  screen_id int [not null]
  start_time datetime [not null]
  end_time datetime [not null]
  base_price decimal(8,2) [not null]
  language varchar(50) [not null]
  show_status varchar(20) [not null]
}

Table Customers {
  customer_id int [pk, not null]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  email varchar(100) [not null, unique]
  phone_number varchar(20)
  registration_date datetime [not null]
  account_status varchar(20) [not null]
  date_of_birth date
}

Table Bookings {
  booking_id int [pk, not null]
  customer_id int [not null]
  showtime_id int [not null]
  booking_reference varchar(30) [not null, unique]
  booking_date datetime [not null]
  booking_status varchar(20) [not null]
  total_amount decimal(10,2) [not null]
  expires_at datetime
}

Table Tickets {
  ticket_id int [pk, not null]
  booking_id int [not null]
  seat_id int [not null]
  ticket_code varchar(50) [not null, unique]
  ticket_price decimal(8,2) [not null]
  ticket_status varchar(20) [not null]
  issued_at datetime [not null]
  checked_in_at datetime
}

Table Payments {
  payment_id int [pk, not null]
  booking_id int [not null]
  amount decimal(10,2) [not null]
  payment_method varchar(30) [not null]
  payment_status varchar(20) [not null]
  transaction_reference varchar(100) [unique]
  attempted_at datetime [not null]
  refunded_at datetime
}

// Database Relationships

Ref: Movies.genre_id > Genres.genre_id

Ref: Screens.theater_id > Theaters.theater_id

Ref: Seats.screen_id > Screens.screen_id

Ref: Showtimes.movie_id > Movies.movie_id

Ref: Showtimes.screen_id > Screens.screen_id

Ref: Bookings.customer_id > Customers.customer_id

Ref: Bookings.showtime_id > Showtimes.showtime_id

Ref: Tickets.booking_id > Bookings.booking_id

Ref: Tickets.seat_id > Seats.seat_id

Ref: Payments.booking_id > Bookings.booking_id
